<!-- Fiori Elements custom form field: preview button (magnifier) for a single attachment (Composition of one) -->
<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Button
    core:require="{ Preview: 'anubhav/attachments/Preview' }"
    icon="sap-icon://zoom-in"
    text="Preview"
    type="Transparent"
    visible="{ path: 'size', formatter: 'Preview.hasFile' }"
    press="Preview.open"
  />
</core:FragmentDefinition>
