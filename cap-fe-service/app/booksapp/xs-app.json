{
  "welcomeFile": "manifest.json",
  "routes": [
    {
      "source": ".*",
      "service": "app-front"
    },
    {
      "source": "^/?odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "csrfProtection": false,
      "authenticationType": "xsuaa"
    }
  ],
  "authenticationMethod": "route"
}
